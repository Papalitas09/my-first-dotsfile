{
    "display": {
        "separator": " ✦ "
    },
    "logo": {
    "source": "~/Pictures/zoro.png",
    "padding": {
        "top": 1,
        "right": 10,
        "left": 10
    },
    "color": {
        "1": "38;5;56"
    },
    "width": 30
},

    "modules": [
        "break",

        // System - Gray
        {
            "type": "custom",
            "format": "\u001b[38;5;245m━━━ System Information ━━━\u001b[0m"
        },

        { "type": "os", "key": " ", "keyColor": "38;5;245" },
        { "type": "kernel", "key": " ", "keyColor": "38;5;245" },
        { "type": "uptime", "key": " ", "keyColor": "38;5;245" },
        { "type": "packages", "key": "󰏓 ", "keyColor": "38;5;245" },

        "break",

        // Desktop - Gray
        {
            "type": "custom",
            "format": "\u001b[38;5;245m━━ Desktop Environment ━━\u001b[0m"
        },

        { "type": "de", "key": "󰧨 ", "keyColor": "38;5;245" },
        { "type": "wm", "key": "󱂬 ", "keyColor": "38;5;245" },
        { "type": "terminal", "key": "󰞷 ", "keyColor": "38;5;245" },
        { "type": "shell", "key": "󰞷 ", "keyColor": "38;5;245" },

        "break",

        // Hardware - Gray
        {
            "type": "custom",
            "format": "\u001b[38;5;245m━━━ Hardware Information ━━━\u001b[0m"
        },

        { "type": "cpu", "key": "󰻠 ", "keyColor": "38;5;245", "format": "{1} ({3})" },
        { "type": "gpu", "key": "󰢮 ", "keyColor": "38;5;245" },
        { "type": "memory", "key": "󰍛 ", "keyColor": "38;5;245" },
        { "type": "disk", "key": "󰋊 ", "keyColor": "38;5;245", "folders": "/" },

        "break",

        //{ "type": "colors", "key": "󰌁 ", "symbol": "block" },

        "break"
    ]
}
